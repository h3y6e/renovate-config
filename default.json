{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    ":timezone(Asia/Tokyo)",
    ":label(dependencies)",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    "schedule:weekly"
  ],
  "nix": {
    "enabled": true
  },
  "rebaseWhen": "conflicted",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths", "pnpmDedupe"],
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "enabled": true
  },
  "minimumReleaseAge": "8 days",
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "matchDatasources": ["conda"],
      "registryUrls": ["https://api.anaconda.org/package/conda-forge"],
      "versioning": "loose"
    }
  ]
}
